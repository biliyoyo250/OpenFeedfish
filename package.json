{
  "name": "feedfish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "connect-account": "node scripts/connect-account.mjs",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler d1 migrations apply feedfish --local && wrangler dev --ip 127.0.0.1 --port 8787 --var LOCAL_DEMO:true",
    "test": "node --test",
    "check": "npm test && npm run build && wrangler deploy --dry-run",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy --cwd pages --project-name feedfish"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "jose": "6.2.15",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "wrangler": "4.157.0"
  }
}

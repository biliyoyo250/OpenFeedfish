{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedfish-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "workers_dev": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin", "/admin/*"] },
  "vars": { "LOCAL_DEMO": "false", "BROWSER_LOGIN_ENABLED": "false", "TURNSTILE_SITE_KEY": "", "PAYMENTS_ENABLED": "false", "DEEPSEEK_ACCOUNT_ID": "", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ADMIN_EMAILS": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "feedfish", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] }
}
